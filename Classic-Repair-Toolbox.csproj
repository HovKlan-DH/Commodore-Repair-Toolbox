<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
		<Title>Classic Repair Toolbox</Title>
		<Product>Classic Repair Toolbox</Product>
		<AssemblyTitle>Classic Repair Toolbox</AssemblyTitle>
		<Company>HovKlan</Company>
		<Authors>Dennis Helligsø</Authors>
		<Copyright>©2025-2026</Copyright>
		<AssemblyName>Classic-Repair-Toolbox</AssemblyName>
		<AssemblyVersion>2.4.0</AssemblyVersion>
		<!--
		<InformationalVersion>$(AssemblyVersion)</InformationalVersion>
		-->
		<InformationalVersion>2.4.0-beta.10</InformationalVersion>
        <OutputType>WinExe</OutputType>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<RollForward>LatestMajor</RollForward>
        <Nullable>enable</Nullable>
        <!--
        Warnings are errors in Release - the configuration CI, the release gate and the
        Stop hook all build. Debug stays warnings-only so a half-finished edit does not
        break the F5/watch loop. The build was at zero warnings when this went in.
        -->
        <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
        <ApplicationManifest>Main\app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
        <!--
        Ahead-of-time compile the app and the self-contained .NET runtime at publish time.
        Without this every framework method on the way to the first pixel is JIT-compiled while the
        user stares at nothing - and none of that time was even visible in the log, because logging
        only starts once Avalonia is already up (see StartupTimeline).

        Conditioned on RuntimeIdentifier because ReadyToRun requires a target RID; a bare
        "dotnet publish" with no -r would otherwise fail. Every publish in
        .github/workflows/build-and-release.yml passes -r, so all four shipped builds get it.
        It trades install size for launch time, which is the right way round for an app that
        already ships ~1 GB of hardware data.
        -->
        <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
        <PackageProjectUrl>https://github.com/HovKlan-DH/Classic-Repair-Toolbox</PackageProjectUrl>
        <PackageIcon>CRT_icon.png</PackageIcon>
        <ApplicationIcon>Assets\CRT_icon.ico</ApplicationIcon>
        <FileVersion>$(AssemblyVersion)</FileVersion>
        <Version>$(InformationalVersion)</Version>
        <Description>A utility tool for classic and retro hardware repairing, troubleshooting and diagnosing.</Description>
</PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
	<PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageReference Include="EPPlus" Version="8.7.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <!--
  The test project lives in Tests/ INSIDE this project's folder, so the SDK's default
  "**/*.cs" glob would otherwise compile the tests (and their bin/obj) into the app.
  -->
  <ItemGroup>
    <Compile Remove="Tests/**" />
    <EmbeddedResource Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>

  <!-- Much of Handlers/ is internal (KiCad loaders, board JSON storage, Excel reader/writer).
       The test project needs to see it; nothing else does. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Classic-Repair-Toolbox.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Tabs/Feedback/TabFeedback.axaml.cs">
      <DependentUpon>TabFeedback.axaml</DependentUpon>
    </Compile>
    <Compile Update="Main/Main.axaml.cs">
      <DependentUpon>Main.axaml</DependentUpon>
    </Compile>
    <Compile Update="Tabs/Oscilloscope/TabOscilloscope.axaml.cs">
      <DependentUpon>TabOscilloscope.axaml</DependentUpon>
    </Compile>
    <Compile Update="Tabs/Overview/TabOverview.axaml.cs">
      <DependentUpon>TabOverview.axaml</DependentUpon>
    </Compile>
    <Compile Update="Properties/Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Main/Splash.axaml.cs">
      <DependentUpon>Splash.axaml</DependentUpon>
    </Compile>
  </ItemGroup>

<!--
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
 </ItemGroup>
 -->
	<ItemGroup>
		<AvaloniaResource Include="Assets/CRT_icon.png" />
		<AvaloniaResource Include="Assets/Fonts/*.otf" />
	</ItemGroup>

  <ItemGroup>
    <Content Include="Assets/CRT_icon.ico" />
  </ItemGroup>

	<!--
	Bundled MiniPro, per-RID, flattened next to the EXE (so "MiniproProcessRunner.ResolveBinary" finds
	it via "AppContext.BaseDirectory"). A RID-targeted publish uses the RID as-is; a plain dev build
	(no RID) falls back to the host OS's natural RID so the committed "minipro.exe" is staged automatically.
	-->
	<PropertyGroup>
		<MiniproRid>$(RuntimeIdentifier)</MiniproRid>
		<MiniproRid Condition="'$(MiniproRid)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">win-x64</MiniproRid>
		<!--
		<MiniproRid Condition="'$(MiniproRid)' == '' And $([MSBuild]::IsOSPlatform('Linux'))">linux-x64</MiniproRid>
		<MiniproRid Condition="'$(MiniproRid)' == '' And $([MSBuild]::IsOSPlatform('OSX'))">osx-x64</MiniproRid>
		-->
	</PropertyGroup>
	<!--
	<ItemGroup Condition="'$(MiniproRid)' != '' And Exists('Assets/MiniPro/$(MiniproRid)')">
	-->
	<ItemGroup Condition="'$(MiniproRid)' != '' And Exists('Assets/MiniPro/$(MiniproRid)') And !$(MiniproRid.StartsWith('linux'))">
		<Content Include="Assets/MiniPro/$(MiniproRid)/**/*">
			<Link>%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Pack>false</Pack>
		</Content>
	</ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets/Changelog.txt" />
    </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties/Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

    <ItemGroup>
	    <AvaloniaResource Update="Assets/CRT_icon.png">
		    <Pack>True</Pack>
		    <PackagePath>\</PackagePath>
	    </AvaloniaResource>
    </ItemGroup>

</Project>
