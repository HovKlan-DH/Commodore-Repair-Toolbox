<!--
TreatAsLocalProperty lets this project override SelfContained even when it arrives as a
command-line (global) property - see the comment on SelfContained below.
-->
<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="SelfContained;PublishSelfContained">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!--
    A self-contained "dotnet publish" run from the repo root with no "-r <rid>" targets the
    SOLUTION, so SelfContained=true lands on this project too. A VSTest project is RID-agnostic
    by SDK design, so the SDK will not infer a RID for it and the whole publish dies with
    NETSDK1191 - even though nothing here is ever published. Force it back off, and skip this
    project entirely when a solution-wide publish walks past it.
    -->
    <SelfContained>false</SelfContained>
    <PublishSelfContained>false</PublishSelfContained>
    <IsPublishable>false</IsPublishable>
    <RootNamespace>Classic_Repair_Toolbox.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Same rule as the app project: no new warning sneaks into Release. -->
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia.Headless only. The Avalonia.Headless.XUnit adapter is bound to xunit v3
         and would collide with the xunit 2.x this suite uses, so UiTest drives the
         headless session directly instead. -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Classic-Repair-Toolbox.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>