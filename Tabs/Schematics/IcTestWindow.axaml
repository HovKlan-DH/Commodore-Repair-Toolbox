<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CRT.IcTestWindow"
        Title="IC Test"
        Width="560" Height="620"
        MinWidth="440" MinHeight="480"
        WindowStartupLocation="CenterOwner">

  <Grid Margin="14" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">

    <TextBlock x:Name="TitleText"
               Grid.Row="0"
               FontSize="16"
               FontWeight="SemiBold"
               TextWrapping="Wrap"
               Margin="0,0,0,8" />

    <!-- Guided handling: chips are tested out of the board, never powered. -->
    <Border Grid.Row="1"
            Background="{DynamicResource Table_Bg}"
            CornerRadius="3"
            Padding="10"
            Margin="0,0,0,8">
      <StackPanel Spacing="4">
        <TextBlock Text="Before you test" FontWeight="Bold" FontSize="12" />
        <TextBlock TextWrapping="Wrap" FontSize="12"
                   Text="Insert the IC in the Minipro programmers ZIF socket and seat it correctly, ensuring pin 1 of the IC aligns with pin 1 of the ZIF socket. Doublecheck that your test and IC is matching to avoid voltage damage to the IC." />
      </StackPanel>
    </Border>

    <TextBlock x:Name="CoverageText"
               Grid.Row="2"
               FontSize="12"
               TextWrapping="Wrap"
               Margin="0,0,0,8" />

    <!-- Test depth (shown only for parts that offer more than one, e.g. the PLA) -->
    <StackPanel x:Name="ModePanel"
                Grid.Row="3"
                Orientation="Horizontal"
                Spacing="8"
                Margin="0,0,0,8"
                IsVisible="False">
      <TextBlock Text="Test depth:" VerticalAlignment="Center" FontSize="12" />
      <ComboBox x:Name="ModeCombo" MinWidth="170" SelectionChanged="OnModeChanged" />
    </StackPanel>

    <CheckBox x:Name="DemoModeCheck"
              Grid.Row="4"
              Content="Demo mode (no hardware — simulated result)"
              FontSize="12"
              Margin="0,0,0,8" />

    <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <Button x:Name="RunButton" Content="Run test" Click="OnRun" />
      <Button x:Name="CancelButton" Content="Cancel" IsEnabled="False" Click="OnCancel" />
      <TextBlock x:Name="ElapsedText" VerticalAlignment="Center" FontSize="12"
                 Foreground="{DynamicResource Fg}" />
    </StackPanel>

    <Border x:Name="ResultBorder"
            Grid.Row="6"
            CornerRadius="3"
            Padding="10"
            Margin="0,0,0,8"
            IsVisible="False">
      <StackPanel Spacing="4">
        <TextBlock x:Name="OutcomeText" FontSize="20" FontWeight="Bold" />
        <TextBlock x:Name="HeadlineText" TextWrapping="Wrap" FontSize="12" />
        <TextBlock x:Name="DetailText" TextWrapping="Wrap" FontSize="11" />
      </StackPanel>
    </Border>

    <!-- Raw per-vector grid: noise on a pass, useful on a fail. Tucked away and
         opened automatically only when something failed. ANSI-stripped in code. -->
    <Expander x:Name="LogExpander"
              Grid.Row="7"
              Header="Raw minipro output"
              FontSize="12"
              IsExpanded="False"
              VerticalAlignment="Top">
      <TextBox x:Name="LogBox"
               IsReadOnly="True"
               AcceptsReturn="True"
               TextWrapping="NoWrap"
               Height="260"
               FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
               FontSize="11"
               VerticalContentAlignment="Top"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </Expander>

    <Button x:Name="CloseButton"
            Grid.Row="8"
            Content="Close"
            HorizontalAlignment="Right"
            Margin="0,8,0,0"
            Click="OnClose" />

  </Grid>

</Window>
