<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CRT"
        x:Class="CRT.WorklogEntryEditorWindow"
        Title="Worklog entry"
        Width="1200"
        Height="800"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Fg}">

	<Window.Styles>
		<!-- Flat, borderless icon button used for the per-row Edit/Delete actions in the Links/
		     Comments/Work-done/Photos/Files lists - no button chrome, just a subtle hover highlight. -->
		<Style Selector="Button.WorklogRowIconButton">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="4" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Cursor" Value="Hand" />
		</Style>
		<Style Selector="Button.WorklogRowIconButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Form_Bg}" />
		</Style>
	</Window.Styles>

	<Grid RowDefinitions="*,Auto" Margin="16">


		<!-- Main split: left = description/lists, right = location preview + photos/files. -->
		<!-- The middle column is a fixed 4px, matching the Schematics tab and the main window: the
		     splitter fills it and takes its colour from the global GridSplitter style, so all three
		     look the same. It used to be Auto with a 6px Transparent splitter, which overrode that
		     style and left an invisible strip the user had to hunt for. -->
		<!-- Named so the code-behind can read and re-apply the splitter position - see
		     RestoreWindowPlacement. -->
		<Grid x:Name="EditorSplitGrid" Grid.Row="0">
			<Grid.ColumnDefinitions>
				<!-- MinWidth on BOTH sides, as in the Schematics tab and the main window. Without it
				     either column can be dragged to nothing: the left one shrank until the state pills
				     were clipped by the splitter, and the right one until the location preview vanished.
				     260 is a little over half the header's natural width - enough to keep the title, the
				     chips and the wrapped pills usable, while still allowing a genuinely narrow left
				     pane for someone who wants the preview large. -->
				<ColumnDefinition Width="3*" MinWidth="260" />
				<ColumnDefinition Width="4" />
				<ColumnDefinition Width="2*" MinWidth="200" />
			</Grid.ColumnDefinitions>

			<!-- Left column owns the header as well as the lists.
			     The id badge, title, category chips and state pills all describe the entry that this
			     side edits, so they end at the splitter rather than spanning the window. Spanning gave
			     a one-line headline the full dialog width and made the split appear to start halfway
			     down the modal. -->
			<Grid Grid.Column="0" RowDefinitions="Auto,*">

			<!-- Header: entry id, title field, category chips, state pills. -->
			<Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,12,12">
				<Border Grid.Column="0"
						x:Name="EditorIdBadge"
						CornerRadius="12"
						Padding="12,5"
						VerticalAlignment="Top"
						Margin="0,4,12,0">
					<TextBlock x:Name="EditorIdText"
							   FontSize="16"
							   FontWeight="Bold"
							   Foreground="White" />
				</Border>

				<StackPanel Grid.Column="1" Spacing="8">
					<TextBox x:Name="EditorTitleTextBox"
							 PlaceholderText="Worklog title"
							 FontSize="16"
							 FontWeight="Bold"
							 TextChanged="OnDirectFieldTextChanged" />

					<!-- WrapPanel, not a horizontal StackPanel: the category chips and the state pills
					     together want ~440px, and the left column can be dragged narrower than that.
					     A StackPanel just overflows its bounds, so the pills slid under the splitter
					     and the right-hand panel drew over them. Wrapping drops the state pills onto
					     a second line instead, so everything stays visible and clickable at any width
					     the MinWidth on the column allows. ItemSpacing/LineSpacing reproduce the 16px
					     gap the StackPanel had. -->
					<WrapPanel Orientation="Horizontal" ItemSpacing="16" LineSpacing="8">
						<StackPanel Orientation="Horizontal" Spacing="5">
							<Border x:Name="EditorCategoryNoteChip"
									VerticalAlignment="Center"
									Background="{DynamicResource Form_Bg}"
									BorderBrush="{DynamicResource Form_Border}"
									BorderThickness="1"
									CornerRadius="3"
									Padding="8,4"
									Cursor="Hand"
									Tag="Note"
									PointerPressed="OnEditorCategoryChipPointerPressed">
								<StackPanel Orientation="Horizontal" Spacing="5" IsHitTestVisible="False">
									<TextBlock x:Name="EditorCategoryNoteText" Text="Note" FontSize="11" Foreground="{DynamicResource Fg}" />
								</StackPanel>
							</Border>
							<Border x:Name="EditorCategoryCosmeticChip"
									VerticalAlignment="Center"
									Background="{DynamicResource Form_Bg}"
									BorderBrush="{DynamicResource Form_Border}"
									BorderThickness="1"
									CornerRadius="3"
									Padding="8,4"
									Cursor="Hand"
									Tag="Cosmetic"
									PointerPressed="OnEditorCategoryChipPointerPressed">
								<StackPanel Orientation="Horizontal" Spacing="5" IsHitTestVisible="False">
									<TextBlock x:Name="EditorCategoryCosmeticText" Text="Cosmetic" FontSize="11" Foreground="{DynamicResource Fg}" />
								</StackPanel>
							</Border>
							<Border x:Name="EditorCategoryIssueChip"
									VerticalAlignment="Center"
									Background="{DynamicResource Form_Bg}"
									BorderBrush="{DynamicResource Form_Border}"
									BorderThickness="1"
									CornerRadius="3"
									Padding="8,4"
									Cursor="Hand"
									Tag="Issue"
									PointerPressed="OnEditorCategoryChipPointerPressed">
								<StackPanel Orientation="Horizontal" Spacing="5" IsHitTestVisible="False">
									<TextBlock x:Name="EditorCategoryIssueText" Text="Issue" FontSize="11" Foreground="{DynamicResource Fg}" />
								</StackPanel>
							</Border>
						</StackPanel>

						<StackPanel Orientation="Horizontal" Spacing="6">
							<Border x:Name="EditorStateOpenPill"
									VerticalAlignment="Center"
									Background="{DynamicResource Form_Bg}"
									BorderBrush="{DynamicResource Form_Border}"
									BorderThickness="1"
									CornerRadius="10"
									Padding="10,2"
									Cursor="Hand"
									Tag="Open"
									PointerPressed="OnEditorStatePillPointerPressed">
								<StackPanel Orientation="Horizontal" Spacing="5" IsHitTestVisible="False">
									<Ellipse x:Name="EditorStateOpenDot" Width="8" Height="8" Fill="{DynamicResource Worklog_Status_Open}" VerticalAlignment="Center" />
									<TextBlock x:Name="EditorStateOpenText" Text="Open" FontSize="11" Foreground="{DynamicResource Fg}" />
								</StackPanel>
							</Border>
							<Border x:Name="EditorStateClosedPill"
									VerticalAlignment="Center"
									Background="{DynamicResource Form_Bg}"
									BorderBrush="{DynamicResource Form_Border}"
									BorderThickness="1"
									CornerRadius="10"
									Padding="10,2"
									Cursor="Hand"
									Tag="Closed"
									PointerPressed="OnEditorStatePillPointerPressed">
								<StackPanel Orientation="Horizontal" Spacing="5" IsHitTestVisible="False">
									<Ellipse x:Name="EditorStateClosedDot" Width="8" Height="8" Fill="{DynamicResource Worklog_Status_Closed}" VerticalAlignment="Center" />
									<TextBlock x:Name="EditorStateClosedText" Text="Closed" FontSize="11" Foreground="{DynamicResource Fg}" />
								</StackPanel>
							</Border>
						</StackPanel>
					</WrapPanel>
				</StackPanel>
			</Grid>

				<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
						<StackPanel Spacing="16" Margin="0,0,12,0">

						<StackPanel Spacing="4">
							<TextBlock Text="Description" FontWeight="SemiBold" />
							<TextBox x:Name="EditorDescriptionTextBox"
									 AcceptsReturn="True"
									 TextWrapping="Wrap"
									 Height="90"
									 VerticalContentAlignment="Top"
									 TextChanged="OnDirectFieldTextChanged" />
							<TextBlock Text="Ctrl+Enter to save"
									   FontSize="10"
									   Opacity="0.6" />
						</StackPanel>

						<StackPanel Spacing="6">
							<Grid ColumnDefinitions="*,Auto">
								<TextBlock Grid.Column="0" Text="Links of interest" FontWeight="SemiBold" VerticalAlignment="Center" />
								<Button Grid.Column="1" Content="Add link" FontSize="11" Padding="8,3" Click="OnAddLinkClick" />
							</Grid>
							<ItemsControl x:Name="EditorLinksList">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="local:WorklogLinkRow">
										<Border Background="{DynamicResource Form_Bg}" BorderBrush="{DynamicResource Form_Border}" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,4" Cursor="Hand" Tag="{Binding Url}" PointerPressed="OnLinkRowPointerPressed" ToolTip.Tip="{Binding Url}">
											<Grid ColumnDefinitions="Auto,*,Auto">
												<Button Grid.Column="0" Classes="WorklogRowIconButton" Margin="0,0,8,0" Click="OnEditLinkClick" Tag="{Binding Id}" ToolTip.Tip="Edit link">
													<TextBlock Text="&#xf044;" FontFamily="{DynamicResource FontAwesomeRegular}" FontSize="13" Foreground="{DynamicResource Schematics_Panels_Fg}" />
												</Button>
												<TextBlock Grid.Column="1" Text="{Binding Headline}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
												<Button Grid.Column="2" Classes="WorklogRowIconButton" Margin="8,0,0,0" Click="OnDeleteLinkClick" Tag="{Binding Id}" ToolTip.Tip="Delete link">
													<TextBlock Text="&#xf2ed;" FontFamily="{DynamicResource FontAwesomeSolid}" FontSize="13" Foreground="{DynamicResource Text_Fail_Fg}" />
												</Button>
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							<TextBlock x:Name="EditorNoLinksText" Text="No links added" FontSize="11" Opacity="0.7" IsVisible="False" />
						</StackPanel>

						<StackPanel Spacing="6">
							<Grid ColumnDefinitions="*,Auto,Auto,Auto">
								<TextBlock Grid.Column="0" x:Name="EditorWorkDoneHeaderText" Text="Work done" FontWeight="SemiBold" VerticalAlignment="Center" />
								<Button Grid.Column="1" Classes="WorklogRowIconButton" Click="OnWorkDoneSortNewestFirstClick" ToolTip.Tip="Newest first">
									<TextBlock x:Name="WorkDoneSortNewestFirstIcon" Text="&#xf160;" FontFamily="{DynamicResource FontAwesomeSolid}" FontSize="12" />
								</Button>
								<Button Grid.Column="2" Classes="WorklogRowIconButton" Margin="2,0,6,0" Click="OnWorkDoneSortOldestFirstClick" ToolTip.Tip="Oldest first">
									<TextBlock x:Name="WorkDoneSortOldestFirstIcon" Text="&#xf161;" FontFamily="{DynamicResource FontAwesomeSolid}" FontSize="12" />
								</Button>
								<Button Grid.Column="3" Content="Add work" FontSize="11" Padding="8,3" Click="OnAddWorkDoneClick" />
							</Grid>
							<ItemsControl x:Name="EditorWorkDoneList">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="local:WorklogWorkDoneRow">
										<Border Background="{DynamicResource Form_Bg}" BorderBrush="{DynamicResource Form_Border}" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,4" Cursor="Hand" Tag="{Binding Id}" PointerPressed="OnWorkDoneRowPointerPressed">
											<Grid ColumnDefinitions="*,Auto">
												<StackPanel Grid.Column="0" Spacing="1">
													<TextBlock Text="{Binding DateText}" FontSize="10" Opacity="0.7" />
													<TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" />
													<TextBlock Text="{Binding SummaryText}" FontSize="11" Opacity="0.8" />
												</StackPanel>
												<Button Grid.Column="1" Classes="WorklogRowIconButton" Margin="8,0,0,0" VerticalAlignment="Top" Click="OnDeleteWorkDoneClick" Tag="{Binding Id}" ToolTip.Tip="Delete work done">
													<TextBlock Text="&#xf2ed;" FontFamily="{DynamicResource FontAwesomeSolid}" FontSize="13" Foreground="{DynamicResource Text_Fail_Fg}" />
												</Button>
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>

						<StackPanel Spacing="6">
							<Grid ColumnDefinitions="*,Auto,Auto,Auto">
								<TextBlock Grid.Column="0" Text="Comments" FontWeight="SemiBold" VerticalAlignment="Center" />
								<Button Grid.Column="1" Classes="WorklogRowIconButton" Click="OnCommentsSortNewestFirstClick" ToolTip.Tip="Newest first">
									<TextBlock x:Name="CommentsSortNewestFirstIcon" Text="&#xf160;" FontFamily="{DynamicResource FontAwesomeSolid}" FontSize="12" />
								</Button>
								<Button Grid.Column="2" Classes="WorklogRowIconButton" Margin="2,0,6,0" Click="OnCommentsSortOldestFirstClick" ToolTip.Tip="Oldest first">
									<TextBlock x:Name="CommentsSortOldestFirstIcon" Text="&#xf161;" FontFamily="{DynamicResource FontAwesomeSolid}" FontSize="12" />
								</Button>
								<Button Grid.Column="3" Content="Add comment" FontSize="11" Padding="8,3" Click="OnAddCommentClick" />
							</Grid>
							<ItemsControl x:Name="EditorCommentsList">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="local:WorklogCommentRow">
										<Border Background="{DynamicResource Form_Bg}" BorderBrush="{DynamicResource Form_Border}" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,4" Cursor="Hand" Tag="{Binding Id}" PointerPressed="OnCommentRowPointerPressed">
											<Grid ColumnDefinitions="*,Auto">
												<StackPanel Grid.Column="0" Spacing="1">
													<TextBlock Text="{Binding DateText}" FontSize="10" Opacity="0.7" />
													<TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" />
												</StackPanel>
												<Button Grid.Column="1" Classes="WorklogRowIconButton" Margin="8,0,0,0" VerticalAlignment="Top" Click="OnDeleteCommentClick" Tag="{Binding Id}" ToolTip.Tip="Delete comment">
													<TextBlock Text="&#xf2ed;" FontFamily="{DynamicResource FontAwesomeSolid}" FontSize="13" Foreground="{DynamicResource Text_Fail_Fg}" />
												</Button>
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>

					</StackPanel>
				</ScrollViewer>
			</Grid>

			<GridSplitter Grid.Column="1"
						  ResizeDirection="Columns"
						  HorizontalAlignment="Stretch" />

			<ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
				<StackPanel Spacing="16" Margin="12,0,0,0">

					<StackPanel Spacing="4">
						<TextBlock Text="Worklog location" FontWeight="SemiBold" />
						<Border Background="{DynamicResource Form_Bg}" BorderBrush="{DynamicResource Form_Border}" BorderThickness="1" CornerRadius="3" Height="220">
							<Grid x:Name="EditorLocationPreviewGrid" ClipToBounds="True">
								<Image x:Name="EditorLocationPreviewImage" Stretch="Uniform" />
								<Canvas x:Name="EditorLocationPreviewOverlayCanvas" IsHitTestVisible="False" />
							</Grid>
						</Border>
						<TextBlock x:Name="EditorLocationSchematicNameText" FontSize="11" Opacity="0.7" />
					</StackPanel>

					<!-- "Mark components in scope", the same checklist the quick "New fault" card
					     shows (see TabSchematics.axaml). The rows are supplied by the caller, which
					     owns the board data and the highlight rectangles; this window only renders
					     them and reports back which are ticked. Hidden entirely when the caller
					     could not work out the scope, rather than showing an empty box that looks
					     like "no components here". -->
					<StackPanel x:Name="EditorComponentScopePanel" Spacing="4" IsVisible="False">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<TextBlock Text="Mark components in scope" FontWeight="SemiBold" VerticalAlignment="Center" />
							<TextBlock x:Name="EditorComponentCountText" Text="0 found" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
							<Button Content="All"
									FontSize="11"
									Padding="0"
									Background="Transparent"
									BorderThickness="0"
									Foreground="{DynamicResource Link_Fg}"
									Cursor="Hand"
									Click="OnEditorSelectAllComponentsClick" />
							<Button Content="None"
									FontSize="11"
									Padding="0"
									Background="Transparent"
									BorderThickness="0"
									Foreground="{DynamicResource Link_Fg}"
									Cursor="Hand"
									Click="OnEditorSelectNoneComponentsClick" />
						</StackPanel>

						<Border Background="{DynamicResource Form_Bg}" BorderBrush="{DynamicResource Form_Border}" BorderThickness="1" CornerRadius="3" MinHeight="40">
							<Grid>
								<TextBlock x:Name="EditorNoComponentsText"
										   Text="No components in this area"
										   FontSize="11"
										   Opacity="0.7"
										   HorizontalAlignment="Center"
										   Margin="8,10"
										   IsVisible="False" />

								<ScrollViewer MaxHeight="160"
											  VerticalScrollBarVisibility="Auto"
											  HorizontalScrollBarVisibility="Disabled">
									<ItemsControl x:Name="EditorComponentList">
										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="local:WorklogEntryComponentRow">
												<Border Background="Transparent"
														Cursor="Hand"
														PointerPressed="OnEditorComponentRowPointerPressed">
													<StackPanel Orientation="Horizontal" Spacing="6" Margin="8,0">
														<Viewbox Width="20" Height="20" IsHitTestVisible="False">
															<CheckBox IsChecked="{Binding IsChecked}"
																	  MinWidth="0"
																	  MinHeight="0"
																	  Margin="0"
																	  Padding="0"
																	  CornerRadius="2"
																	  IsHitTestVisible="False"
																	  VerticalAlignment="Center" />
														</Viewbox>
														<TextBlock Text="{Binding BoardLabel}"
																   FontSize="11"
																   FontWeight="Bold"
																   VerticalAlignment="Center"
																   IsHitTestVisible="False" />
														<TextBlock Text="{Binding DisplayName}"
																   FontSize="11"
																   VerticalAlignment="Center"
																   TextTrimming="CharacterEllipsis"
																   IsHitTestVisible="False" />
													</StackPanel>
												</Border>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</ScrollViewer>
							</Grid>
						</Border>
					</StackPanel>

					<StackPanel Spacing="6">
						<Grid ColumnDefinitions="*,Auto">
							<TextBlock Grid.Column="0" Text="Photos" FontWeight="SemiBold" VerticalAlignment="Center" />
							<Button Grid.Column="1" Content="Add photo" FontSize="11" Padding="8,3" Click="OnAddPhotoClick" />
						</Grid>
						<ItemsControl x:Name="EditorPhotosList">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="local:WorklogAttachmentRow">
									<Grid>

										<!-- Shown in place of the row while it is being dragged: an empty outlined
										     slot the height of the row, marking exactly where a drop will land.
										     The dragged row itself moves through the list, so the surrounding
										     rows already sit in the order the drop will produce. -->
										<!-- A Rectangle rather than a Border: only shapes carry StrokeDashArray,
										     Border has no dashed-edge option at all. RadiusX/Y keep the rounded
										     corners the real rows have. -->
										<Panel IsVisible="{Binding IsDropPlaceholder}"
											   Height="{Binding PlaceholderHeight}"
											   Margin="0,0,0,4">
											<Rectangle Stroke="{DynamicResource Text_Fail_Fg}"
													   StrokeThickness="2"
													   StrokeDashArray="4,3"
													   RadiusX="3"
													   RadiusY="3"
													   Fill="{DynamicResource Bg}" />
											<TextBlock Text="Move the image up/down and release mouse button for new location"
													   FontSize="11"
													   Opacity="0.7"
													   TextWrapping="Wrap"
													   TextAlignment="Center"
													   Margin="14,0"
													   HorizontalAlignment="Center"
													   VerticalAlignment="Center" />
										</Panel>

									<Border IsVisible="{Binding IsNotDropPlaceholder}" Background="{DynamicResource Form_Bg}" BorderBrush="{DynamicResource Form_Border}" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,4">
										<Grid ColumnDefinitions="Auto,*">

											<!-- The thumbnail is the click target for the full-size viewer: the big
											     obvious target views, while the small explicit button edits.
											     No fixed box and no frame: the image is sized by its own aspect
											     ratio (MaxHeight caps it, width follows), so a wide screenshot
											     no longer sits in a tall square padded with empty space. -->
											<Panel Grid.Column="0"
												   Margin="0,0,8,0"
												   Cursor="Hand"
												   Background="Transparent"
												   Tag="{Binding Id}"
												   PointerPressed="OnPhotoThumbnailPointerPressed"
												   ToolTip.Tip="Click to view">
												<Image Source="{Binding Thumbnail}"
													   Stretch="Uniform"
													   MaxWidth="200"
													   MaxHeight="144"
													   VerticalAlignment="Center"
													   IsVisible="{Binding HasThumbnail}" />

												<!-- The missing-file marker has no image to size it, so it keeps a
												     box - otherwise the row would collapse to the icon's height. -->
												<Border Width="96"
														Height="96"
														Background="{DynamicResource Bg}"
														BorderBrush="{DynamicResource Form_Border}"
														BorderThickness="1"
														CornerRadius="2"
														IsVisible="{Binding HasNoThumbnail}">
													<TextBlock Text="&#xf127;"
															   FontFamily="{DynamicResource FontAwesomeSolid}"
															   FontSize="26"
															   Opacity="0.5"
															   HorizontalAlignment="Center"
															   VerticalAlignment="Center"
															   ToolTip.Tip="This photo's file is missing" />
												</Border>
											</Panel>

											<!-- The comment takes the whole remaining width, with the Edit/Delete
											     icons floated over its top-right corner rather than given their own
											     columns - at this width a reserved icon column costs the text more
											     room than the icons need. The text is padded on the right so a long
											     comment wraps clear of them instead of running underneath.

											     This panel is also the drag handle for reordering, which is why it
											     carries the north/south cursor and fills the column even when the
											     comment is short or absent. Background must be set (not left null)
											     or the blank area is not hit-testable and the drag never starts.

											     Deliberately no tooltip: the panel spans the whole row, so a tooltip
											     here pops up over the comment text and the rows below it. The
											     north/south cursor already says the row can be dragged. -->
											<Panel Grid.Column="1"
												   Background="Transparent"
												   Cursor="SizeNorthSouth"
												   Tag="{Binding Id}"
												   PointerPressed="OnPhotoRowDragHandlePointerPressed">
												<TextBlock Text="{Binding Comment}"
														   FontSize="11"
														   Opacity="0.8"
														   TextWrapping="Wrap"
														   VerticalAlignment="Center"
														   Margin="0,20,0,0"
														   IsVisible="{Binding HasComment}" />

												<!-- Same edit icon as the Links rows (FontAwesomeRegular f044), with a
												     gap before Delete so a mis-aimed click on Edit cannot hit the
												     destructive action next to it. -->
												<StackPanel Orientation="Horizontal"
															Spacing="6"
															HorizontalAlignment="Right"
															VerticalAlignment="Top">
													<Button Classes="WorklogRowIconButton" Click="OnEditPhotoClick" Tag="{Binding Id}" ToolTip.Tip="Edit photo">
														<TextBlock Text="&#xf044;" FontFamily="{DynamicResource FontAwesomeRegular}" FontSize="13" Foreground="{DynamicResource Schematics_Panels_Fg}" />
													</Button>
													<Button Classes="WorklogRowIconButton" Click="OnDeletePhotoClick" Tag="{Binding Id}" ToolTip.Tip="Delete photo">
														<TextBlock Text="&#xf2ed;" FontFamily="{DynamicResource FontAwesomeSolid}" FontSize="13" Foreground="{DynamicResource Text_Fail_Fg}" />
													</Button>
												</StackPanel>
											</Panel>
										</Grid>
									</Border>

									</Grid>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
						<TextBlock x:Name="EditorNoPhotosText" Text="No photos added" FontSize="11" Opacity="0.7" IsVisible="False" />
					</StackPanel>

					<StackPanel Spacing="6">
						<Grid ColumnDefinitions="*,Auto">
							<TextBlock Grid.Column="0" Text="Files" FontWeight="SemiBold" VerticalAlignment="Center" />
							<Button Grid.Column="1" Content="Add file" FontSize="11" Padding="8,3" Click="OnAddFileClick" />
						</Grid>
						<ItemsControl x:Name="EditorFilesList">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="local:WorklogAttachmentRow">
									<Grid>

										<!-- Same drag placeholder as the Photos rows: an outlined slot marking
										     where the drop will land. See the Photos template above. -->
										<Panel IsVisible="{Binding IsDropPlaceholder}"
											   Height="{Binding PlaceholderHeight}"
											   Margin="0,0,0,4">
											<Rectangle Stroke="{DynamicResource Text_Fail_Fg}"
													   StrokeThickness="2"
													   StrokeDashArray="4,3"
													   RadiusX="3"
													   RadiusY="3"
													   Fill="{DynamicResource Bg}" />
											<TextBlock Text="Move the file up/down and release mouse button for new location"
													   FontSize="11"
													   Opacity="0.7"
													   TextWrapping="Wrap"
													   TextAlignment="Center"
													   Margin="14,0"
													   HorizontalAlignment="Center"
													   VerticalAlignment="Center" />
										</Panel>

									<Border IsVisible="{Binding IsNotDropPlaceholder}" Background="{DynamicResource Form_Bg}" BorderBrush="{DynamicResource Form_Border}" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,4">
										<Grid ColumnDefinitions="*,Auto,Auto">

											<!-- Empty space doubles as the drag handle, exactly as in the Photos
											     rows. The link sits INSIDE this panel, so its handler marks the
											     press handled - otherwise clicking it would open the file and arm
											     a reorder at the same time. The icon buttons are outside the panel
											     and handle their own presses. -->
											<Panel Grid.Column="0"
												   Background="Transparent"
												   Cursor="SizeNorthSouth"
												   Tag="{Binding Id}"
												   PointerPressed="OnFileRowDragHandlePointerPressed">
												<StackPanel Spacing="1" VerticalAlignment="Center">
													<!-- The file name is the link: clicking it opens the file through
													     ExternalTargetLauncher. Shown without its storage prefix.

													     The handler sits on a Border carrying a Background, not on the
													     TextBlock: a control with no background is not hit-testable in
													     Avalonia, so a PointerPressed on the bare TextBlock never fired
													     and the link did nothing. Transparent still counts as a
													     background for hit-testing - null does not. The Links rows
													     above put their handler on a Border for the same reason. -->
													<Border Background="Transparent"
															Cursor="Hand"
															HorizontalAlignment="Left"
															Tag="{Binding Id}"
															PointerPressed="OnFileRowPointerPressed"
															ToolTip.Tip="Open this file">
														<TextBlock Text="{Binding DisplayFileName}"
																   FontWeight="SemiBold"
																   FontSize="11"
																   TextTrimming="CharacterEllipsis"
																   Foreground="{DynamicResource Link_Fg}"
																   TextDecorations="Underline" />
													</Border>
													<TextBlock Text="{Binding Comment}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" IsVisible="{Binding HasComment}" />
												</StackPanel>
											</Panel>

											<Button Grid.Column="1" Classes="WorklogRowIconButton" Margin="4,0,0,0" VerticalAlignment="Top" Click="OnEditFileClick" Tag="{Binding Id}" ToolTip.Tip="Edit file">
												<TextBlock Text="&#xf044;" FontFamily="{DynamicResource FontAwesomeRegular}" FontSize="13" Foreground="{DynamicResource Schematics_Panels_Fg}" />
											</Button>
											<Button Grid.Column="2" Classes="WorklogRowIconButton" Margin="6,0,0,0" VerticalAlignment="Top" Click="OnDeleteFileClick" Tag="{Binding Id}" ToolTip.Tip="Delete file">
												<TextBlock Text="&#xf2ed;" FontFamily="{DynamicResource FontAwesomeSolid}" FontSize="13" Foreground="{DynamicResource Text_Fail_Fg}" />
											</Button>
										</Grid>
									</Border>

									</Grid>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
						<TextBlock x:Name="EditorNoFilesText" Text="No files added" FontSize="11" Opacity="0.7" IsVisible="False" />
					</StackPanel>

				</StackPanel>
			</ScrollViewer>
		</Grid>

		<!-- Footer: Cancel / Save, with the save-failed message beside them (see OnSaveClick). -->
		<StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
			<TextBlock x:Name="EditorSaveFailedText"
					   Text="Could not save - see the log for details."
					   Foreground="{DynamicResource Text_Fail_Fg}"
					   FontSize="11"
					   VerticalAlignment="Center"
					   IsVisible="False" />
			<Button Content="Cancel" Padding="14,6" Click="OnCancelClick" />
			<Button x:Name="EditorSaveButton"
					Content="Save"
					Padding="14,6"
					IsEnabled="False"
					Foreground="{DynamicResource Button_Ok_Fg}"
					Background="{DynamicResource Button_Ok_Bg}"
					BorderBrush="{DynamicResource Button_Ok_Border}"
					Click="OnSaveClick" />
		</StackPanel>
	</Grid>
</Window>
