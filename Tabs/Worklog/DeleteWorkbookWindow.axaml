<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CRT.DeleteWorkbookWindow"
        Title="Delete workbook"
        Width="420"
        MinWidth="380"
        CanResize="False"
        CanMinimize="False"
        ShowInTaskbar="False"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Fg}">

	<StackPanel Margin="18" Spacing="4">
		<TextBlock x:Name="HeaderText" Text="Delete workbook" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" />

		<TextBlock x:Name="MessageText"
				   TextWrapping="Wrap"
				   Text="This permanently deletes the workbook and everything recorded in it - worklog entries, photos and files. This cannot be undone." />

		<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,16,0,0">
			<Button Content="Cancel" Click="OnCancelClick" />
			<Button x:Name="DeleteButton"
					Content="Delete workbook"
					Foreground="{DynamicResource Button_Cancel_Fg}"
					Background="{DynamicResource Button_Cancel_Bg}"
					BorderBrush="{DynamicResource Button_Cancel_Border}"
					Click="OnDeleteClick" />
		</StackPanel>
	</StackPanel>
</Window>
