<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CRT"
             x:Class="CRT.TabContribute">

	<UserControl.Styles>
		<Style Selector="Button.ComponentEntryButton">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Left" />
			<Setter Property="Foreground" Value="{DynamicResource Link_Fg}" />
			<Setter Property="Cursor" Value="Hand" />
		</Style>

		<Style Selector="Button.ComponentEntryButton /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>

		<Style Selector="Border.ContributeRow">
			<Setter Property="Background" Value="Transparent" />
		</Style>

		<Style Selector="Border.ContributeRow:pointerover">
			<Setter Property="Background" Value="{DynamicResource Table_RowHover_Bg}" />
		</Style>

		<Style Selector="Button.AddNewComponentButton">
			<Setter Property="Background" Value="{DynamicResource Button_Highlighted_Bg}" />
			<Setter Property="Foreground" Value="{DynamicResource Button_Highlighted_Fg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Button_Highlighted_Border}" />
			<Setter Property="Padding" Value="14,8" />
		</Style>
	</UserControl.Styles>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- The intro text, with the "add" button parked in the top-right corner of the tab. The
		     text column is star-sized and wraps, so it gives way to the button instead of running
		     underneath it however narrow the window gets. -->
		<Grid Grid.Row="0"
			  ColumnDefinitions="*,16,Auto"
			  Margin="12,12,12,12">
			<StackPanel Grid.Column="0" Spacing="6">
				<TextBlock TextWrapping="Wrap" >
					To contribute and enhance the data quality for this board, then you can select an existing component and give feedback where data is wrong or missing. Your contribution will be seen as a "suggestion for changes" and will be sent directly to the developer, who will incorporate it in to the backend data set.
				</TextBlock>
				<TextBlock Text="The list below holds the components the board data already has - use the button to the right for one that is missing from it."
						   TextWrapping="Wrap" />
			</StackPanel>

			<Button Grid.Column="2"
					x:Name="AddNewComponentButton"
					Classes="AddNewComponentButton"
					Content="Add new component"
					IsEnabled="False"
					VerticalAlignment="Top"
					ToolTip.Tip="Suggest a component that is missing from this board entirely"
					Click="OnAddNewComponentClick" />
		</Grid>

		<!-- Board revision date section -->
		<StackPanel x:Name="RevisionDatePanel"
					Grid.Row="1"
					Orientation="Horizontal"
					Spacing="4"
					Margin="12,0,12,12"
					IsVisible="False">
			<TextBlock Text="Board Excel data last revisioned:"
					   FontSize="14" />
			<TextBlock x:Name="RevisionDateText"
					   FontSize="14"
					   FontWeight="Bold" />
		</StackPanel>

		<ScrollViewer Grid.Row="2"
					  HorizontalScrollBarVisibility="Auto"
					  VerticalScrollBarVisibility="Auto"
					  AllowAutoHide="False">
			<ItemsControl x:Name="CategoriesItemsControl" Margin="12,0,12,12">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Orientation="Horizontal" Spacing="60" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="local:CategoryColumn">
						<Grid Width="110"
						      VerticalAlignment="Top">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
							</Grid.RowDefinitions>
							<TextBlock Grid.Row="0"
							           Text="{Binding CategoryName}"
							           FontWeight="Bold"
							           FontSize="14"
							           TextTrimming="CharacterEllipsis"/>
							<Border Grid.Row="1"
							        Height="1"
							        Background="{DynamicResource Table_BorderRowLine}"
							        Margin="0,4,0,8" />
							<ItemsControl Grid.Row="2" ItemsSource="{Binding Components}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="local:ContributeComponentItem">
										<Border Classes="ContributeRow"
										        Margin="0,2,0,2">
											<Button Classes="ComponentEntryButton"
											        Content="{Binding DisplayText}"
											        Tag="{Binding}"
											        ToolTip.Tip="{Binding ToolTipText}"
											        Click="OnComponentClick" />
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</Grid>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>
	</Grid>
</UserControl>