<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CRT"
		xmlns:shapes="clr-namespace:Avalonia.Controls.Shapes;assembly=Avalonia.Controls"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="CRT.Main"
        Title="Classic Repair Toolbox"
        MinWidth="800"
        MinHeight="500">

	<Window.Styles>

		<!-- Base tab font size and reduced vertical padding -->
		<Style Selector="TabItem">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Padding" Value="12,4" />
		</Style>

		<!-- Hover: show a faint underline indicator -->
		<Style Selector="TabItem:pointerover /template/ Border#PART_SelectedPipe">
			<Setter Property="IsVisible" Value="True" />
		</Style>
		
		<!-- Banner dismiss button: subtle hover on dark background -->
		<Style Selector="Button.BannerDismissButton">
			<Setter Property="BorderThickness" Value="0" />
		</Style>

		<!-- Region toggle buttons -->
		<Style Selector="Button.RegionToggle.active">
			<Setter Property="BorderThickness" Value="2" />
		</Style>

		<!-- PAL active -->
		<Style Selector="Button#PalRegionButton.RegionToggle.active">
			<Setter Property="Foreground" Value="{DynamicResource Schematics_Region_PAL_Fg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Schematics_Region_PAL_Bg}" />
		</Style>
		<Style Selector="Button#PalRegionButton.RegionToggle.active /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Schematics_Region_PAL_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Schematics_Region_PAL_Bg}" />
		</Style>

		<!-- NTSC active -->
		<Style Selector="Button#NtscRegionButton.RegionToggle.active">
			<Setter Property="Foreground" Value="{DynamicResource Schematics_Region_NTSC_Fg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Schematics_Region_NTSC_Bg}" />
		</Style>
		<Style Selector="Button#NtscRegionButton.RegionToggle.active /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Schematics_Region_NTSC_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Schematics_Region_NTSC_Bg}" />
		</Style>

	</Window.Styles>

	<Grid x:Name="RootGrid">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="200" MinWidth="80" />
			<ColumnDefinition Width="4" />
			<ColumnDefinition Width="*" MinWidth="100" />
		</Grid.ColumnDefinitions>

		<Border x:Name="LeftPanel"
			Background="{DynamicResource Bg}"
			BorderBrush="{DynamicResource Border}"
			Grid.Column="0"
			Padding="16">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<!-- Hardware, Board and Category selectors -->
				<Grid Grid.Row="1"
					  Margin="0,8,0,0">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<TextBlock Grid.Row="0"
							   Text="Hardware"
							   FontSize="11" />
					<ComboBox Grid.Row="1"
							  x:Name="HardwareComboBox"
							  HorizontalAlignment="Stretch"
							  Margin="0,8,0,0" />
					<TextBlock Grid.Row="2"
							   Text="Board"
							   FontSize="11"
							   Foreground="{DynamicResource Fg}"
							   Margin="0,8,0,0" />
					<ComboBox Grid.Row="3"
							  x:Name="BoardComboBox"
							  HorizontalAlignment="Stretch"
							  Margin="0,8,0,0" />
					<TextBlock Grid.Row="4"
							   Text="Category"
							   FontSize="11"
							   Foreground="{DynamicResource Fg}"
							   Margin="0,8,0,0" />
					<ListBox Grid.Row="5"
							 x:Name="CategoryFilterListBox"
							 SelectionMode="Multiple,Toggle"
							 Margin="0,8,0,0"
							 BorderThickness="1"
							 CornerRadius="4"
							 ClipToBounds="True"
							 Padding="0"
							 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
						<ListBox.Styles>
							<Style Selector="ListBox /template/ Border">
								<Setter Property="CornerRadius" Value="3" />
								<Setter Property="ClipToBounds" Value="True" />
							</Style>
							<Style Selector="ListBox /template/ ScrollViewer">
								<Setter Property="CornerRadius" Value="3" />
								<Setter Property="ClipToBounds" Value="True" />
							</Style>
							<Style Selector="ListBoxItem">
								<Setter Property="Padding" Value="8,3" />
								<Setter Property="MinHeight" Value="0" />
								<Setter Property="FontSize" Value="11" />
							</Style>
						</ListBox.Styles>
					</ListBox>

					<TextBlock Grid.Row="6"
							   Text="Component"
							   FontSize="11"
							   Foreground="{DynamicResource Fg}"
							   Margin="0,8,0,0" />
					<ListBox Grid.Row="7"
							 x:Name="ComponentFilterListBox"
							 SelectionMode="Multiple,Toggle"
							 Margin="0,8,0,0"
							 BorderThickness="1"
							 CornerRadius="4"
							 ClipToBounds="True"
							 Padding="0"
							 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
						<ListBox.Styles>
							<Style Selector="ListBox /template/ Border">
								<Setter Property="CornerRadius" Value="3" />
								<Setter Property="ClipToBounds" Value="True" />
							</Style>
							<Style Selector="ListBox /template/ ScrollViewer">
								<Setter Property="CornerRadius" Value="3" />
								<Setter Property="ClipToBounds" Value="True" />
							</Style>

							<!-- Default (non-selected) state -->
							<Style Selector="ListBoxItem">
								<Setter Property="Padding" Value="8,3" />
								<Setter Property="MinHeight" Value="0" />
								<Setter Property="FontSize" Value="11" />
							</Style>
						</ListBox.Styles>
					</ListBox>
				</Grid>

				<!-- Action Controls -->
				<StackPanel Grid.Row="2" Margin="0,12,0,0" Spacing="4">
					<TextBox x:Name="ComponentSearchTextBox"
							 FontSize="12"
							 MinHeight="0"
							 Padding="4"
							VerticalContentAlignment="Center"
							TextChanged="OnComponentSearchTextChanged">
					</TextBox>

					<!-- Selection Actions -->
					<Grid ColumnDefinitions="*,4,*">
						<Button Grid.Column="0"
								Content="Clear"
								HorizontalAlignment="Stretch"
								HorizontalContentAlignment="Center"
								FontSize="12"
								Padding="4"
								Click="OnClearComponentsClick" />
						<Button Grid.Column="2"
								Content="Mark all"
								HorizontalAlignment="Stretch"
								HorizontalContentAlignment="Center"
								FontSize="12"
								Padding="4"
								Click="OnMarkAllComponentsClick" />
					</Grid>

					<!-- Video standard -->
					<Grid x:Name="RegionButtonsGrid" ColumnDefinitions="*,4,*">
						<Button x:Name="PalRegionButton"
								Classes="RegionToggle"
								Grid.Column="0"
								Content="PAL"
								HorizontalAlignment="Stretch"
								HorizontalContentAlignment="Center"
								FontSize="12"
								Padding="4"
								Click="OnPalRegionClick" />
						<Button x:Name="NtscRegionButton"
								Classes="RegionToggle"
								Grid.Column="2"
								Content="NTSC"
								HorizontalAlignment="Stretch"
								HorizontalContentAlignment="Center"
								FontSize="12"
								Padding="4"
								Click="OnNtscRegionClick" />
					</Grid>

					<!-- View options -->
					<Grid ColumnDefinitions="*,4,*">
						<Button Grid.Column="0"
								Content="Fullscreen"
								HorizontalAlignment="Stretch"
								HorizontalContentAlignment="Center"
								FontSize="12"
								Padding="4"
								Click="OnFullscreenSchematicsClick" />

						<CheckBox x:Name="BlinkSelectedCheckBox"
							  Grid.Column="2"
							  Content="Blink selected"
							  HorizontalAlignment="Left"
							  FontSize="12"
							  VerticalAlignment="Center"
							  IsCheckedChanged="OnBlinkSelectedChanged" />
					</Grid>
				</StackPanel>

			</Grid>
		</Border>

		<!-- Left Splitter -->
		<GridSplitter x:Name="MainSplitter"
					  Grid.Column="1"
					  ResizeDirection="Columns"
					  HorizontalAlignment="Stretch" />

		<!-- Right Panel -->
		<Border x:Name="RightPanel"
				Grid.Column="2"
				Background="{DynamicResource Bg}"
				BorderBrush="{DynamicResource Border}"
				BorderThickness="1"
				Padding="0,0,0,0">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>

				<!-- Main Excel compatibility warning banner -->
				<Border x:Name="MainExcelRequiresAppUpdateBanner"
					Grid.Row="0"
					IsVisible="False"
					Background="{DynamicResource Main_Banner_Bg}"
					CornerRadius="0"
					Margin="0,0,0,1"
					Padding="12,6">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<TextBlock x:Name="MainExcelRequiresAppUpdateBannerText"
								   Grid.Column="0"
								   VerticalAlignment="Center"
								   Foreground="{DynamicResource Main_Banner_Fg}"
								   FontSize="12"
								   TextWrapping="Wrap" />

						<Button x:Name="MainExcelRequiresAppUpdateBannerDismissButton"
								Grid.Column="1"
								Classes="BannerDismissButton"
								Content="✕"
								FontSize="11"
								Padding="6,3"
								Click="OnMainExcelRequiresAppUpdateBannerDismiss" />
					</Grid>
				</Border>

				<!-- Update notification banner -->
				<Border x:Name="UpdateBanner"
					Grid.Row="1"
					IsVisible="False"
					Background="{DynamicResource Main_Banner_Bg}"
					CornerRadius="0"
					Margin="0,0,0,4"
					Padding="12,6">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<TextBlock x:Name="UpdateBannerText"
								   Grid.Column="0"
								   VerticalAlignment="Center"
								   Foreground="{DynamicResource Main_Banner_Fg}"
								   FontSize="12" />

						<Button x:Name="UpdateBannerViewNotesButton"
								Grid.Column="1"
								Classes="BannerDismissButton"
								Content="View release notes"
								Margin="12,0,4,0"
								FontSize="11"
								Padding="6,3"
								Click="OnViewReleaseNotesClick" />

						<Button x:Name="UpdateBannerInstallButton"
								Grid.Column="2"
								Classes="BannerInstallButton"
								Content="Install"
								Margin="0,0,4,0"
								Background="{DynamicResource Button_Highlighted_Bg}"
								Foreground="{DynamicResource Button_Highlighted_Fg}"
								BorderBrush="{DynamicResource Button_Highlighted_Border}"
								FontSize="11"
								Padding="10,3"
								Click="OnInstallUpdateClick" />

						<Button x:Name="UpdateBannerDismissButton"
								Grid.Column="3"
								Classes="BannerDismissButton"
								Content="✕"
								FontSize="11"
								Padding="6,3"
								Click="OnUpdateBannerDismiss" />
					</Grid>
				</Border>

				<!-- Data sync notification banner -->
				<Border x:Name="SyncBanner"
						Grid.Row="2"
						IsVisible="False"
						Background="{DynamicResource Main_Banner_Bg}"
						CornerRadius="0"
						Margin="0,0,0,4"
						Padding="12,6"
						Cursor="Hand"
						PointerPressed="OnSyncBannerPointerPressed">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<TextBlock x:Name="SyncBannerText"
								   Grid.Column="0"
								   VerticalAlignment="Center"
								   Foreground="{DynamicResource Main_Banner_Fg}"
								   FontSize="12" />

						<Button x:Name="SyncBannerRefreshButton"
								Grid.Column="1"
								Classes="BannerInstallButton"
								Content="Refresh Board"
								IsVisible="False"
								Margin="12,0,4,0"
								Background="{DynamicResource Button_Highlighted_Bg}"
								Foreground="{DynamicResource Button_Highlighted_Fg}"
								BorderBrush="{DynamicResource Button_Highlighted_Border}"
								FontSize="11"
								Padding="10,3"
								Click="OnRefreshBoardClick" />

						<Button x:Name="SyncBannerDismissButton"
								Grid.Column="2"
								Classes="BannerDismissButton"
								Content="✕"
								FontSize="11"
								Padding="6,3"
								Click="OnSyncBannerDismiss" />
					</Grid>
				</Border>

				<!-- Component label editor mode banner -->
				<Border x:Name="SchematicsLabelEditorModeBanner"
						Grid.Row="3"
						IsVisible="False"
						Background="{DynamicResource Main_Banner_Bg}"
						CornerRadius="0"
						Margin="0,0,0,4"
						Padding="12,6">
					<TextBlock Text="Component label editor mode is active. Hardware, board, and schematic navigation are temporarily locked until changes are applied or discarded."
							   VerticalAlignment="Center"
							   Foreground="{DynamicResource Main_Banner_Fg}"
							   FontSize="12"
							   TextWrapping="Wrap" />
				</Border>

				<TabControl x:Name="MainTabControl" Grid.Row="4" Padding="0">

					<TabItem x:Name="SchematicsTabItem" Header="Schematics">
						<local:TabSchematics x:Name="TabSchematicsControl" />
					</TabItem>

					<TabItem Header="Overview">
						<local:TabOverview x:Name="TabOverview" />
					</TabItem>

					<TabItem Header="Resources">
						<local:TabResources x:Name="TabResources" />
					</TabItem>

					<TabItem Header="Oscilloscope" IsVisible="True">
						<local:TabOscilloscope x:Name="TabOscilloscope" />
					</TabItem>

					<TabItem Header="Contribute">
						<local:TabContribute x:Name="TabContribute" />
					</TabItem>

					<TabItem x:Name="ConfigurationTabItem" Header="Configuration">
						<local:TabConfiguration x:Name="TabConfiguration" />
					</TabItem>

					<TabItem Header="Feedback" IsVisible="True">
						<local:TabFeedback x:Name="TabFeedback" />
					</TabItem>

					<TabItem Header="About">
						<local:TabAbout x:Name="TabAbout" />
					</TabItem>

				</TabControl>

				<Border x:Name="DataSyncStatusIconBorder"
						Grid.Row="4"
						ZIndex="10"
						HorizontalAlignment="Right"
						VerticalAlignment="Top"
						Margin="0,15,15,0"
						Width="22"
						Height="22"
						Background="Transparent"
						ClipToBounds="True"
						PointerEntered="OnDataSyncStatusIconPointerEntered"
						PointerExited="OnDataSyncStatusIconPointerExited"
						PointerPressed="OnDataSyncStatusIconPointerPressed">
					<Grid Width="22"
						  Height="22"
						  ClipToBounds="True">

						<TextBlock x:Name="DataSyncStatusIconTextBlock"
								   Width="22"
								   Height="22"
								   FontFamily="{StaticResource FontAwesomeSolid}"
								   FontWeight="Black"
								   FontSize="18"
								   TextAlignment="Center"
								   HorizontalAlignment="Center"
								   VerticalAlignment="Center" />

						<Canvas x:Name="DataSyncStatusSpinnerCanvas"
								Width="22"
								Height="22"
								IsVisible="False"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								ClipToBounds="True">
							<shapes:Ellipse x:Name="DataSyncStatusSpinnerEllipse"
											Width="20"
											Height="20"
											Canvas.Left="3"
											Canvas.Top="3"
											StrokeThickness="3"
											StrokeLineCap="Round"
											StrokeDashArray="12,40" />
						</Canvas>

					</Grid>
				</Border>

			</Grid>
		</Border>

	</Grid>

</Window>